PORT=3000

JWT_MODE=dev
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=project-api
JWT_SCOPES=api:read
CLIENT_ID=local-client
CLIENT_SECRET=local-client-secret

# Production: set JWT_MODE=jwks and configure the issuer's JWKS endpoint.
# JWT_JWKS_URI=https://identity.example.com/.well-known/jwks.json

DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_name
DB_USERNAME=postgres
DB_PASSWORD=postgres

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=treasury.program-capacity
KAFKA_DLQ_TOPIC=treasury.program-capacity.dlq
KAFKA_GROUP_ID=capacity-service
KAFKA_RETRY_INITIAL_TIME_MS=300
KAFKA_RETRY_MULTIPLIER=2
KAFKA_RETRY_MAX_TIME_MS=30000
KAFKA_RETRY_COUNT=5